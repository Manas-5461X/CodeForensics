# ==============================================================================
# CodeForensics — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit .env or real credentials to source control.
# - Distinguish frontend client variables (prefixed with VITE_) from server secrets.
# - Server-only secrets MUST never be exposed to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Persistence (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeforensics_dev?schema=public"

# ------------------------------------------------------------------------------
# 3. Background Job Queue (Redis & BullMQ)
# ------------------------------------------------------------------------------
# Connection string for BullMQ workers and queue scheduling
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Firebase Authentication — Frontend Client (apps/web)
# ------------------------------------------------------------------------------
# Public Firebase Web SDK configuration. These values are bundled into the client.
VITE_API_BASE_URL="http://localhost:3001"
VITE_FIREBASE_API_KEY="placeholder-api-key"
VITE_FIREBASE_AUTH_DOMAIN="codeforensics-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="codeforensics-dev"
VITE_FIREBASE_STORAGE_BUCKET="codeforensics-dev.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------------------------------------------
# 5. Firebase Admin SDK — Backend Token Verification (apps/api)
# ------------------------------------------------------------------------------
# Used by Fastify API to verify client Bearer ID tokens.
# SERVER ONLY — DO NOT EXPOSE TO CLIENT.
FIREBASE_PROJECT_ID="codeforensics-dev"
# Path to service account JSON OR individual service account fields:
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@codeforensics-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. GitHub App Integration (apps/api & apps/worker)
# ------------------------------------------------------------------------------
# Used for repository sync, webhooks, and rate-limited API access.
# SERVER ONLY — DO NOT EXPOSE TO CLIENT.
GITHUB_APP_ID="123456"
GITHUB_CLIENT_ID="Iv1.placeholder"
GITHUB_CLIENT_SECRET="placeholder-github-client-secret"
GITHUB_WEBHOOK_SECRET="development-webhook-secret-min-32-chars"
# Path to GitHub App private key (.pem) or base64-encoded string:
GITHUB_PRIVATE_KEY_PATH=""

# ------------------------------------------------------------------------------
# 7. Background Worker Configuration (apps/worker)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_WORKSPACE_DIR="./tmp/workspaces"

# ------------------------------------------------------------------------------
# 8. Observability & Diagnostics (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN=""
# LOG_LEVEL=info
