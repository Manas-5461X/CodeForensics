{
  "name": "codeforensics",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed repository intelligence platform",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@codeforensics/web",
    "dev:api": "npm run dev --workspace=@codeforensics/api",
    "dev:worker": "npm run dev --workspace=@codeforensics/worker",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run db:generate && npm run build --workspace=@codeforensics/shared && npm run build --workspace=@codeforensics/api && npm run build --workspace=@codeforensics/worker",
    "build:web": "npm run build --workspace=@codeforensics/shared && npm run build --workspace=@codeforensics/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "start": "node apps/api/dist/server.js",
    "start:api": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/index.js",
    "start:combined": "node apps/api/dist/server.js & node apps/worker/dist/index.js"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
